---
import ToolPageLayout from '../../components/ToolPageLayout.astro';
import { getLiveTools } from '../../lib/cms';
import { getToolContent } from '../../data/tool-content';
import style0 from '../../styles/caffeine-curfew.css?inline';
import style1 from '../../styles/caffeine-tracker.css?inline';
import style2 from '../../styles/diary.css?inline';
import style3 from '../../styles/healthspan.css?inline';
import style4 from '../../styles/hrv.css?inline';
import style5 from '../../styles/fasting.css?inline';
import style6 from '../../styles/lifestyle-age.css?inline';
import style7 from '../../styles/meal-plan.css?inline';
import style8 from '../../styles/muscle-preservation.css?inline';
import style9 from '../../styles/recipe-analyzer.css?inline';
import style10 from '../../styles/sitting-reversal.css?inline';
import style11 from '../../styles/chronotype.css?inline';
import style12 from '../../styles/strength-program.css?inline';
import style13 from '../../styles/walk-it-off.css?inline';
import style14 from '../../styles/weight-timeline.css?inline';

// Engine CSS is inlined (Vite ?inline = processed, minified CSS). A separate <link> was a
// render-blocking request on the critical path: run 43627861871 measured these pages ~150 ms
// later FCP/LCP than CSS-inlined templates (meal plan LCP 1965/1968/2268 ms vs 2000 ms budget).
const styles: Record<string, string> = {
  'caffeine-curfew-calculator': style0,
  'caffeine-intake-calculator': style1,
  'food-symptom-diary': style2,
  'healthspan-score': style3,
  'hrv-explainer-log': style4,
  'intermittent-fasting-calculator': style5,
  'lifestyle-age-test': style6,
  'meal-plan-generator': style7,
  'muscle-preservation-calculator': style8,
  'recipe-nutrition-analyzer': style9,
  'sitting-disease-reversal-calculator': style10,
  'sleep-chronotype-quiz': style11,
  'strength-program-builder': style12,
  'walk-it-off-calculator': style13,
  'weight-loss-timeline-calculator': style14,
};

export async function getStaticPaths() {
  const liveTools = await getLiveTools();
  return liveTools.map((tool) => {
    const content = getToolContent(tool.slug);
    if (!content) throw new Error(`Published tool has no authored content: ${tool.slug}`);
    return { params: { slug: tool.slug }, props: { tool, content } };
  });
}

const { tool, content } = Astro.props;
---

<ToolPageLayout tool={tool} content={content} inlineCss={styles[tool.slug]} />
