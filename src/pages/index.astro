---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import WhyTrust from '../components/home/WhyTrust.astro';
import Faq from '../components/home/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Icon from '../components/Icon.astro';
import { getPopularTools, getCategories } from '../lib/cms';
import { getSiteConsts } from '../lib/cms';
import { HOME_FAQ } from '../data/faq';

const [popular, categories, siteConsts] = await Promise.all([getPopularTools(6), getCategories(), getSiteConsts()]);
const SITE = siteConsts.SITE;

// FAQPage structured data for the homepage FAQ.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const title = 'Free Health Calculators & Tools | HealthyLifeStyles';
const description =
  'Free health calculators for BMI, calories, macros, and more. No account needed; see our privacy policy for how individual tools process data.';
---

<BaseLayout title={title} description={description} jsonLd={[faqJsonLd]}>
  <Hero />

  <!-- Popular tools -->
  <section class="section" aria-labelledby="popular-title">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <span class="eyebrow">Most used</span>
          <h2 id="popular-title">Popular tools</h2>
        </div>
        <a href="/tools" class="btn btn-outline">
          View all tools <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <ul class="grid grid--tools">
        {popular.map((tool) => (
          <li><ToolCard tool={tool} /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Categories -->
  <section class="section section-mint" aria-labelledby="cat-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Browse by topic</span>
        <h2 id="cat-title">Explore tool categories</h2>
        <p class="lead">
          From nutrition to heart health, find the right calculator for whatever
          you’re working on.
        </p>
      </div>
      <ul class="grid grid--cats">
        {categories.map((category) => (
          <li><CategoryCard category={category} /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Original server-rendered editorial introduction: indexable without JavaScript. -->
  <section class="section" aria-labelledby="about-platform">
    <div class="container container-narrow">
      <div class="section-head">
        <span class="eyebrow">About HealthyLifeStyles</span>
        <h2 id="about-platform">Practical health tools with transparent methods</h2>
      </div>
      <p>HealthyLifeStyles brings everyday health calculations and evidence-informed wellness guidance together in one free, accessible place. You can estimate calorie needs, compare body measurements, explore heart-rate targets, and reflect on sleep habits without creating an account. Our goal is to make the assumptions behind each result understandable, rather than present an estimate as a personal diagnosis.</p>
      <p>Different tools use different kinds of evidence. For example, some energy calculations use the Mifflin–St Jeor equation, while body-fat estimates may use the U.S. Navy circumference method. Self-report screeners such as WHO-5 and PHQ-9 are questionnaires, not metabolic equations, and their scores must not be treated as medical diagnoses. On relevant tool pages we explain formulas, inputs, limitations, and sources so you can judge whether a result fits your question.</p>
      <p>Many calculators run directly in your browser. Other features may contact our servers or save preferences locally, so our <a href="/privacy">privacy policy</a> explains important differences instead of promising that every input stays on your device. Our <a href="/methodology">methodology</a> and <a href="/editorial-policy">editorial policy</a> describe how we present references and review our content. You remain in control of how to use the information, and individual clinical decisions belong with qualified healthcare professionals.</p>
    </div>
  </section>

  <WhyTrust />
  <Faq />

  <!-- Final CTA -->
  <section class="cta-band">
    <div class="container cta-band__inner">
      <div>
        <h2>Ready to know your numbers?</h2>
        <p>
          Take the free Health Score assessment for a personalized snapshot of
          your wellness in under two minutes.
        </p>
      </div>
      <a href="/health-score" class="btn btn-primary btn-lg">
        Get My Health Score <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .section-head--row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    text-align: left;
    max-width: none;
    margin-inline: 0;
  }
  .section-head--row h2 {
    margin-top: 0.3rem;
  }

  .grid {
    display: grid;
    gap: 1.25rem;
  }
  .grid--tools {
    grid-template-columns: repeat(3, 1fr);
  }
  .grid--cats {
    grid-template-columns: repeat(3, 1fr);
  }
  .grid li {
    display: flex;
  }
  .grid li > :global(*) {
    width: 100%;
  }

  @media (max-width: 920px) {
    .grid--tools,
    .grid--cats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid--tools,
    .grid--cats {
      grid-template-columns: 1fr;
    }
    .section-head--row {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Final CTA band */
  .cta-band {
    background:
      radial-gradient(600px 300px at 100% 0%, rgba(34, 197, 94, 0.2), transparent 60%),
      var(--dark);
    color: #fff;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta-band h2 {
    color: #fff;
    margin: 0 0 0.5rem;
  }
  .cta-band p {
    color: #cbd5e1;
    margin: 0;
    max-width: 52ch;
  }
</style>
