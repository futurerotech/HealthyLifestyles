---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import WhyTrust from '../components/home/WhyTrust.astro';
import Faq from '../components/home/Faq.astro';
import ToolCard from '../components/ToolCard.astro';
import CategoryCard from '../components/CategoryCard.astro';
import Icon from '../components/Icon.astro';
import { getPopularTools, getCategories } from '../lib/cms';
import { getSiteConsts } from '../lib/cms';
import { HOME_FAQ } from '../data/faq';

const [popular, categories, siteConsts] = await Promise.all([getPopularTools(6), getCategories(), getSiteConsts()]);
const SITE = siteConsts.SITE;

// FAQPage structured data for the homepage FAQ.
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: HOME_FAQ.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};

const title = 'Free Health Calculators & Tools | HealthyLifeStyles';
const description =
  'Free health calculators for BMI, calories, macros, and more. No account needed; see our privacy policy for how individual tools process data.';
---

<BaseLayout title={title} description={description} jsonLd={[faqJsonLd]}>
  <Hero />

  <!-- Popular tools -->
  <section class="section" aria-labelledby="popular-title">
    <div class="container">
      <div class="section-head section-head--row">
        <div>
          <span class="eyebrow">Most used</span>
          <h2 id="popular-title">Popular tools</h2>
        </div>
        <a href="/tools" class="btn btn-outline">
          View all tools <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <ul class="grid grid--tools">
        {popular.map((tool) => (
          <li><ToolCard tool={tool} /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Categories -->
  <section class="section section-mint" aria-labelledby="cat-title">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Browse by topic</span>
        <h2 id="cat-title">Explore tool categories</h2>
        <p class="lead">
          From nutrition to heart health, find the right calculator for whatever
          you’re working on.
        </p>
      </div>
      <ul class="grid grid--cats">
        {categories.map((category) => (
          <li><CategoryCard category={category} /></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="about-platform">
    <div class="container container-narrow">
      <div class="section-head">
        <span class="eyebrow">About HealthyLifeStyles</span>
        <h2 id="about-platform">Understand your health numbers, not just calculate them</h2>
      </div>
      <p>HealthyLifeStyles offers free health and wellness calculators to help you understand measurements used in fitness, nutrition, and preventive health discussions. Explore our <a href="/tools">tool directory</a> for estimates of calorie needs, body composition, and other wellness measures. Each method has a particular purpose, and the meaning of a number depends on how it was calculated. Our goal is to make assumptions visible rather than present every result as a precise personal prediction.</p>
      <p>Our tools draw on published scientific methods where appropriate, including the Mifflin–St Jeor equation for estimating resting energy expenditure and circumference-based U.S. Navy approaches to estimating body fat. Well-being and symptom questionnaires, including WHO-5 and PHQ-9, assess self-reported experiences instead of measuring body composition or energy requirements. A screening score is not a diagnosis. Even established formulas can differ from measurements made with clinical equipment, and their accuracy varies across people and populations.</p>
      <p>We pair calculator results with plain-language explanations of inputs, limitations, and practical next steps. Privacy is an important design priority: routine calculators are designed to process entered values in the browser without requiring a personal account. Other site services, including analytics, may have separate data practices described in our <a href="/privacy">privacy policy</a>. HealthyLifeStyles is an educational resource, not a substitute for individualized medical assessment. For symptoms, health conditions, or treatment decisions, seek guidance from a qualified health professional.</p>
    </div>
  </section>

  <WhyTrust />
  <Faq />

  <!-- Final CTA -->
  <section class="cta-band">
    <div class="container cta-band__inner">
      <div>
        <h2>Ready to know your numbers?</h2>
        <p>
          Take the free Health Score assessment for a personalized snapshot of
          your wellness in under two minutes.
        </p>
      </div>
      <a href="/health-score" class="btn btn-primary btn-lg">
        Get My Health Score <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .section-head--row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
    text-align: left;
    max-width: none;
    margin-inline: 0;
  }
  .section-head--row h2 {
    margin-top: 0.3rem;
  }

  .grid {
    display: grid;
    gap: 1.25rem;
  }
  .grid--tools {
    grid-template-columns: repeat(3, 1fr);
  }
  .grid--cats {
    grid-template-columns: repeat(3, 1fr);
  }
  .grid li {
    display: flex;
  }
  .grid li > :global(*) {
    width: 100%;
  }

  @media (max-width: 920px) {
    .grid--tools,
    .grid--cats {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .grid--tools,
    .grid--cats {
      grid-template-columns: 1fr;
    }
    .section-head--row {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* Final CTA band */
  .cta-band {
    background:
      radial-gradient(600px 300px at 100% 0%, rgba(34, 197, 94, 0.2), transparent 60%),
      var(--dark);
    color: #fff;
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .cta-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
  }
  .cta-band h2 {
    color: #fff;
    margin: 0 0 0.5rem;
  }
  .cta-band p {
    color: #cbd5e1;
    margin: 0;
    max-width: 52ch;
  }
</style>
