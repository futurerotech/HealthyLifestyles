---
/**
 * The ONE and ONLY AdSense loader for the whole site.
 *
 * Loads adsbygoogle.js once after explicit consent, using the standard async
 * Google integration. Every ad UNIT comes
 * from the <AdSlot> component, driven by the Ad Management global — no ad code
 * lives anywhere else. Also wires the sticky-footer ad's close button.
 */
import { getAdConfig } from '../lib/ad-config';

const adConfig = await getAdConfig();

// When the CMS is unreachable, the AdSense library never loads.
// There is no static fallback — the CMS is the sole authority.
const masterOn = adConfig ? adConfig.adsenseEnabled === true : false;
const clientId = adConfig?.adsenseClient || '';
const enabled = masterOn && !!clientId && /^ca-pub-\d+$/.test(clientId);
---

<script is:inline data-pt-skip define:vars={{ enabled, clientId }}>
  (function () {
    function loadAds() {
      if (window.HLS_CONSENT !== 'accept' || document.prerendering) return;
      if (!enabled || window.HLS_ADS_LOADED) return;
      window.HLS_ADS_LOADED = true;
      var s = document.createElement('script');
      s.async = true;
      s.crossOrigin = 'anonymous';
      s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + clientId;
      document.head.appendChild(s);
    }
    loadAds();
    document.addEventListener('consent-update', loadAds);
    document.addEventListener('prerenderingchange', loadAds);
  })();
</script>

<!-- Sticky footer ad close button -->
<script is:inline data-pt-skip>
  document.addEventListener('click', function (e) {
    var btn = e.target && e.target.closest && e.target.closest('[data-close-sticky]');
    if (btn) {
      var sticky = btn.closest('.ad--sticky');
      if (sticky) sticky.classList.add('ad--sticky-hidden');
    }
  });
</script>
