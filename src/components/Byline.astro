---
/**
 * Author byline with optional, explicitly assigned person reviewer.
 */
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import { getAuthors } from '../lib/cms';
import { resolveAuthorIdentity } from '../lib/author-identity.mjs';
import { assignedReviewer } from '../lib/medical-review';
import { formatDate } from '../lib/text';

interface Props {
  /** Explicit author slug or display name; no implicit attribution. */
  author?: string;
  /** ISO date of a substantive content update, when available. */
  updated?: string;
  /** Explicit reviewer assignment; never inferred from a site-wide default. */
  reviewer?: string;
  class?: string;
}

const allAuthors = await getAuthors();
const { author, updated, reviewer, class: className } = Astro.props;
const a = resolveAuthorIdentity(author, allAuthors);
const r = assignedReviewer(reviewer, allAuthors);
---

<div class:list={['byline', className]}>
  {a && <Avatar initials={a.initials} color={a.color} size={40} class="byline__avatar" />}
  <p class="byline__text">
    {a ? <>Written by <a href={`/author/${a.slug}`}>{a.name}</a></> : <span>Author not specified</span>}
    {r && (
      <>
        <span class="byline__sep" aria-hidden="true">·</span>
        Medically reviewed by <a href={`/author/${r.slug}`}>{r.name}</a>{r.credential ? `, ${r.credential}` : ''}
      </>
    )}
    {updated && (
      <>
        <span class="byline__sep" aria-hidden="true">·</span>
        <span class="byline__updated"><Icon name="check" size={13} /> Updated {formatDate(updated)}</span>
      </>
    )}
  </p>
</div>

<style>
  .byline {
    display: flex;
    align-items: center;
    gap: 0.7rem;
  }
  .byline__text {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .byline__text a {
    color: var(--green-700);
    font-weight: 600;
  }
  .byline__sep {
    margin: 0 0.35rem;
    color: var(--border);
  }
  .byline__updated {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    white-space: nowrap;
  }
  .byline__updated svg {
    color: var(--green-primary);
  }
</style>
