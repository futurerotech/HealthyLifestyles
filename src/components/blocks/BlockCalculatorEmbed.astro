---
import ToolEmbed from '../ToolEmbed.astro';
import { canonicalToolSlug } from '../../lib/site-routes';
export interface Props {
  tool: { slug: string; name?: string } | null;
  variant?: 'inline' | 'banner';
}
const { tool } = Astro.props;
---

{tool?.slug && <ToolEmbed slug={canonicalToolSlug(tool.slug)} label={tool.name} />}
