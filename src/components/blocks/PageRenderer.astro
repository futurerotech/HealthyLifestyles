---
import BlockHero from './BlockHero.astro';
import BlockCalculatorEmbed from './BlockCalculatorEmbed.astro';
import BlockTwoColumn from './BlockTwoColumn.astro';
import BlockViralHookBanner from './BlockViralHookBanner.astro';
import BlockContent from './BlockContent.astro';

export interface Props {
  layout: Block[];
  headingLevel?: 'h1' | 'h2';
}

type Block = {
  blockType: string;
  [key: string]: unknown;
};

const { layout, headingLevel = 'h1' } = Astro.props;

function blockComponent(type: string): any {
  const map: Record<string, any> = {
    hero: BlockHero,
    calculatorEmbed: BlockCalculatorEmbed,
    twoColumn: BlockTwoColumn,
    viralHookBanner: BlockViralHookBanner,
    text: BlockContent,
    list: BlockContent,
    callout: BlockContent,
    table: BlockContent,
    peopleAlsoAsk: BlockContent,
    toolEmbed: BlockContent,
  };
  return map[type] || null;
}
---

{
  layout.map((block, i) => {
    const Component = blockComponent(block.blockType);
    if (!Component) {
      throw new Error(`Unsupported CMS page block: ${block.blockType}`);
    }
    return <Component {...block} headingLevel={headingLevel} />;
  })
}
