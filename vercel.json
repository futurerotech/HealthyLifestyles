{
  "git": {
    "deploymentEnabled": {
      "codex/**": false
    }
  },
  "headers": [
    {
      "source": "/content-manifest.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests; frame-ancestors 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(), microphone=(), camera=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/((?!api/|_astro/|fonts/|og/|content-manifest\\.json$).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/embed/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "upgrade-insecure-requests; frame-ancestors *"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tools/body-fat-percentage-calculator",
      "destination": "/tools/body-fat-calculator",
      "permanent": true
    },
    {
      "source": "/tools/how-much-protein-do-i-need",
      "destination": "/tools/protein-intake-calculator",
      "permanent": true
    },
    {
      "source": "/articles/how-are-calories-burned-calculated-a-guide-to-energy-expenditure",
      "destination": "/wellness-hub/calories-burned-calculator-guide",
      "permanent": true
    },
    {
      "source": "/articles/how-many-calories-should-i-eat-to-lose-weight",
      "destination": "/wellness-hub/how-many-calories-to-lose-weight",
      "permanent": true
    },
    {
      "source": "/articles/understanding-basal-metabolic-rate-bmr",
      "destination": "/tools/bmr-calculator",
      "permanent": true
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "healthylifesstyles.com"
        }
      ],
      "headers": {
        "Location": "https://www.healthylifesstyles.com/$1"
      },
      "status": 301
    },
    {
      "src": "/(?:game|games)(?:/.*)?",
      "status": 410,
      "headers": {
        "X-Robots-Tag": "noindex",
        "Cache-Control": "public, max-age=300"
      }
    },
    {
      "src": "/index\\.php(?:/.*)?",
      "status": 410,
      "headers": {
        "X-Robots-Tag": "noindex",
        "Cache-Control": "public, max-age=300"
      }
    },
    {
      "src": "/(?:wp-content|wp-admin|wp-includes|category|tag)(?:/.*)?",
      "status": 410,
      "headers": {
        "X-Robots-Tag": "noindex",
        "Cache-Control": "public, max-age=300"
      }
    }
  ]
}
